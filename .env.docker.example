# Exemplo de .env para uso com Docker
# Copie este arquivo para .env e preencha com seus valores

# Modo de execução
BOT_MODE=polling  # ou "webhook" para produção

# OpenAI API Key (obrigatório)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token (obrigatório)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Webhook (apenas para BOT_MODE=webhook)
TELEGRAM_WEBHOOK_SECRET=seu-segredo-super-secreto
TELEGRAM_WEBHOOK_URL=https://seudominio.com/webhook/telegram

# Os caminhos do banco de dados são configurados automaticamente no container
# DATABASE_PATH=/app/data/financas.db
# CHECKPOINTS_PATH=/app/data/checkpoints.db

# Web V1
WEB_AUTH_PASSWORD=senha-forte-aqui
WEB_SESSION_SECRET=change-me-in-production
WEB_PORT=8080
